PORT=3000

# Anthropic
ANTHROPIC_API_KEY=
# Timeout por llamada a Claude (milisegundos)
ANTHROPIC_REQUEST_TIMEOUT_MS=30000

# Voyage AI (embeddings para búsqueda semántica de agent_instructions)
VOYAGE_API_KEY=

# Supabase
# SUPABASE_URL: solo la URL base del proyecto, SIN /rest/v1 al final
# (ej. https://xxxx.supabase.co)
SUPABASE_URL=
SUPABASE_KEY=

# WhatsApp (Meta Cloud API) — desactivado en código hasta reactivar el canal
# WHATSAPP_TOKEN=
# WHATSAPP_VERIFY_TOKEN=

# Telegram (Bot API) - canal de pruebas mientras se resuelve el alta en Meta
TELEGRAM_BOT_TOKEN=

# Google Sheets (calendario de eventos) — necesarias para la sync horaria
# GOOGLE_SHEETS_CREDENTIALS_BASE64: JSON de la cuenta de servicio de Google
# codificado en base64 (ej. base64 -i credenciales.json | tr -d '\n')
GOOGLE_SHEETS_CREDENTIALS_BASE64=
GOOGLE_SHEET_ID=

# Intervalo de sincronización del calendario (minutos)
EVENTS_SYNC_INTERVAL_MINUTES=60
